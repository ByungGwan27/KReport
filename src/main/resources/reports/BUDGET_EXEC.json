{
  "schemaVersion": 1,
  "reportId": "BUDGET_EXEC",
  "name": "부서별 세출 집행 현황",
  "description": "회계연도별 부서 세출 예산의 집행 실적을 부서 소계와 총계로 집계한다.",
  "page": {
    "paperSize": "A4",
    "orientation": "PORTRAIT",
    "marginTop": 36,
    "marginRight": 28,
    "marginBottom": 36,
    "marginLeft": 28
  },
  "dataSet": {
    "sourceType": "SQL",
    "sql": "select dept_code, dept_name, program_name, account_name, exec_date,\n       vendor_name, budget_amt, exec_amt, status\n  from budget_execution\n where fiscal_year = :fiscalYear\n   and dept_code like :deptCode\n order by dept_code, exec_date, exec_id",
    "maxRows": 50000
  },
  "parameters": [
    {
      "name": "fiscalYear",
      "label": "회계연도",
      "dataType": "NUMBER",
      "required": true,
      "defaultValue": "2026"
    },
    {
      "name": "deptCode",
      "label": "부서",
      "dataType": "STRING",
      "required": true,
      "defaultValue": "%",
      "options": [
        {
          "value": "%",
          "label": "전체"
        },
        {
          "value": "1100",
          "label": "기획예산담당관"
        },
        {
          "value": "1200",
          "label": "행정지원과"
        },
        {
          "value": "2100",
          "label": "복지정책과"
        },
        {
          "value": "2200",
          "label": "환경관리과"
        },
        {
          "value": "3100",
          "label": "도시계획과"
        },
        {
          "value": "3200",
          "label": "교통행정과"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "dept",
      "expression": "{DEPT_CODE}",
      "pageBreak": false,
      "resetPageNumber": false,
      "repeatHeaderOnNewPage": true
    }

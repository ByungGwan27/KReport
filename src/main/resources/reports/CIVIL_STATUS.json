{
  "schemaVersion": 1,
  "reportId": "CIVIL_STATUS",
  "name": "민원 처리 현황 대장",
  "description": "기간별 민원 접수·처리 현황을 처리부서 단위로 집계하고 기한 경과 건을 표시한다.",
  "page": {
    "paperSize": "A4",
    "orientation": "PORTRAIT",
    "marginTop": 36,
    "marginRight": 28,
    "marginBottom": 36,
    "marginLeft": 28
  },
  "dataSet": {
    "sourceType": "SQL",
    "sql": "select complaint_no, dept_name, category, title, applicant_name,\n       received_date, due_date, completed_date, handler_name, status, satisfaction\n  from civil_complaint\n where received_date between :fromDate and :toDate\n   and dept_name like :deptName\n order by dept_name, received_date, complaint_no",
    "maxRows": 50000
  },
  "parameters": [
    {
      "name": "fromDate",
      "label": "접수일(시작)",
      "dataType": "DATE",
      "required": true,
      "defaultValue": "2026-06-01"
    },
    {
      "name": "toDate",
      "label": "접수일(종료)",
      "dataType": "DATE",
      "required": true,
      "defaultValue": "2026-08-31"
    },
    {
      "name": "deptName",
      "label": "처리부서",
      "dataType": "STRING",
      "required": true,
      "defaultValue": "%",
      "options": [
        {
          "value": "%",
          "label": "전체"
        },
        {
          "value": "행정지원과",
          "label": "행정지원과"
        },
        {
          "value": "복지정책과",
          "label": "복지정책과"
        },
        {
          "value": "환경관리과",
          "label": "환경관리과"
        },
        {
          "value": "도시계획과",
          "label": "도시계획과"
        },
        {
          "value": "교통행정과",
          "label": "교통행정과"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "dept",
      "expression": "{DEPT_NAME}",
      "pageBreak": false,
      "resetPageNumber": false,
      "repeatHeaderOnNewPage": true
    }
  ],

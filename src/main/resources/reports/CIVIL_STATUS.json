            "series": [
              {
                "name": "처리완료",
                "expression": "{STATUS} == '처리완료' ? 1 : 0",
                "aggregation": "SUM"
              },
              {
                "name": "처리중",
                "expression": "{STATUS} == '처리중' ? 1 : 0",
                "aggregation": "SUM"
              },
              {
                "name": "반려",
                "expression": "{STATUS} == '반려' ? 1 : 0",
                "aggregation": "SUM"
              }
            ],
            "sort": "VALUE_DESC",
            "showValues": true,
            "valueFormat": "#,##0",
            "title": "부서별 처리 상태 (누적)"

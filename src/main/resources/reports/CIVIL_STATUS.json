          },
          "printWhen": "!({COMPLETED_DATE} != null ? DATEDIFF({DUE_DATE}, {COMPLETED_DATE}) > 0 : DATEDIFF({DUE_DATE}, TODAY()) > 0)"
        },
        {
          "id": "d_status_late",
          "type": "TEXT",
          "expression": "{STATUS} + ' (지연)'",

{
  "schemaVersion": 1,
  "reportId": "CONTRACT_STATUS",
  "name": "계약 체결 현황",
  "description": "계약방법별 계약 내역과 계약 규모 분포를 함께 본다.",
  "page": {
    "paperSize": "A4",
    "orientation": "PORTRAIT",
    "marginTop": 36,
    "marginRight": 28,
    "marginBottom": 36,
    "marginLeft": 28
  },
  "dataSet": {
    "sourceType": "SQL",
    "sql": "select contract_no, dept_name, method, contract_kind, subject,\n       vendor_name, contract_date, amount\n  from contract_award\n where amount >= :minAmount\n   and method like :method\n order by method, amount desc",
    "maxRows": 50000
  },
  "parameters": [
    {
      "name": "fiscalYear",
      "label": "회계연도",
      "dataType": "NUMBER",
      "required": true,
      "defaultValue": "2026"
    },
    {
      "name": "minAmount",
      "label": "최소 계약금액",
      "dataType": "NUMBER",
      "required": true,
      "defaultValue": "0"
    },
    {
      "name": "method",
      "label": "계약방법",
      "dataType": "STRING",
      "required": true,
      "defaultValue": "%",
      "options": [
        {
          "value": "%",
          "label": "전체"
        },
        {
          "value": "일반경쟁",
          "label": "일반경쟁"
        },
        {
          "value": "제한경쟁",
          "label": "제한경쟁"
        },
        {
          "value": "지명경쟁",
          "label": "지명경쟁"
        },
        {
          "value": "수의계약",
          "label": "수의계약"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "method",
      "expression": "{METHOD}",
      "pageBreak": false,
      "resetPageNumber": false,
      "repeatHeaderOnNewPage": true
    }
  ],
